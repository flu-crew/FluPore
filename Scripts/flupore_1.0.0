#!/bin/bash




#Exit when any command fails
#set -e

#The directory where FluPore is held
FLUPORE_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

#FluPore's version
VERSION="1.0.0"


##### Define functions #####
#Print the help menu
function print_help_menu() {
    cat <<helpChunk

    ##########################################################################
                       Welcome to FluPore version ${VERSION}!
    ##########################################################################
    Dependencies for this program are dorado, ivar, r, and IRMA
    For this help menu use the argument -h

    WARNING: ENSURE THAT YOU ARE NOT RUNNING THIS ON THE HEADNODE!

    Arguments:
        -i : Input directory. Default is 'fastq_pass'
        -o : Output directory. Default is 'fastq_pass_Demultiplexed'.
        -t : Number of threads. Default is 1.
	-a : Assemly folder for storing the output of IRMA within each barcode
             folder inside of the demultiplexing birectory. Default is
             "assembly".
        -k : Dorado barcode kit name (required unless skipping demultiplexing).
             Examples: SQK-RBK114-24, SQK-RBK114-96, SQK-NBD114-24.
             Run 'dorado demux --list-kits' to see all available kits.
        -m : Dorado basecalling model (only used when pod5 files are detected).
             Default is 'auto' which detects the model from pod5 metadata.
             Examples: dna_r10.4.1_e8.2_400bps_hac@v4.3.0
             NOTE: basecalling requires a GPU for practical runtimes.
        -r : Path to a multi-segment reference FASTA for variant calling
             (e.g., all 8 flu segments in one file). If not provided,
             variant calling is skipped with a warning.
        -f : Minimum allele frequency for iVar variant calling (0-1).
             Default is 0.03 (3%). Recommended: 0.05 for R9.4.1 chemistry,
             0.01-0.03 for R10.4.1 chemistry.
        -d : Minimum read depth for iVar variant calling. Default is 20.
             Recommended: 200+ for reliable low-frequency variant detection.
        -c : Minimum alt-read count. Default is 10. Recorded in config.cfg
             and used by FluLens as the default floor for grading calls;
             iVar does not filter on it, so calls are kept, not removed.
        -s : Skip a portion of FluPore. Options: '0' = skip nothing,
             'g' = skip Dorado demultiplexing, 'v' = skip variant calling,
             'i' = skip IRMA assembly,
             'c' = skip collecting IRMA results into combined fasta files,
             and skip QC statistic calculations, 'm' = skip MAFFT assembly
              and FastTree ML tree construction, and 's' = skip swine clade
             prediction. These options may be combined. Default is 0.

        --version : prints the version number.

helpChunk
    exit 1
}


EvenMedian () {
    totVals=$1
    dataFile=$2

    medRow1=$(( (totVals + 1) / 2 ))
    medRow2=$(( ((totVals + 1) / 2) + 1 ))

    medLow=$(head -n $medRow1 $dataFile | tail -n 1 | cut -f 3)
    medHigh=$(head -n $medRow2 $dataFile | tail -n 1 | cut -f 3)
    med=$(echo "scale=1 ; ($medLow + $medHigh) / 2" | bc)
}


OddMedian () {
    totVals=$1
    dataFile=$2

    medRow=$(( (totVals + 1) / 2 ))
    medTmp=$(head -n $medRow $dataFile | tail -n 1 | cut -f 3)
    med=$(echo "scale=1 ; $medTmp" | bc)
}




##### Body #####
#Assign defaults to variables
INP_DIR="./fastq_pass"
DEM_DIR="./fastq_pass_Demultiplexed"
NTHREADS=1
IRMA_SAMP_NAME="assembly"
KIT_NAME=""
BASECALL_MODEL="auto"
REF_FASTA=""
MIN_FREQ=0.03
MIN_DEPTH=20
MIN_ALT=10
SKIP_DORADO=0; SKIP_IRMA=0; SKIP_COMBINE=0
SKIP_MAFFT=0; SKIP_HOSTPRED=0; SKIP_CLADEPRED=0; SKIP_VARIANTS=0


#Go through input and assign input arguments to variables
while getopts ":i:o:t:a:k:m:r:f:d:c:s:-:h" opt; do
    case ${opt} in 
      i )
        INP_DIR=$OPTARG
        ;;
      o )
        DEM_DIR=$OPTARG
        ;;
      t )
        NTHREADS=$OPTARG
        ;;
      a )
        IRMA_SAMP_NAME="$OPTARG"
        ;;
      k )
        KIT_NAME=$OPTARG
        ;;
      m )
        BASECALL_MODEL=$OPTARG
        ;;
      r )
        REF_FASTA=$OPTARG
        ;;
      f )
        MIN_FREQ=$OPTARG
        ;;
      d )
        MIN_DEPTH=$OPTARG
        ;;
      c )
        MIN_ALT=$OPTARG
        ;;
      s )
        if [[ $OPTARG != *"0"* ]]; then
            if [[ $OPTARG == *"g"* ]]; then
                SKIP_DORADO=1
            fi
            if [[ $OPTARG == *"i"* ]]; then
                SKIP_IRMA=1
            fi
            if [[ $OPTARG == *"c"* ]]; then
                SKIP_COMBINE=1
            fi
            if [[ $OPTARG == *"m"* ]]; then
                SKIP_MAFFT=1
            fi
            if [[ $OPTARG == *"h"* ]]; then
                SKIP_HOSTPRED=1
            fi
            if [[ $OPTARG == *"s"* ]]; then
                SKIP_CLADEPRED=1
            fi
            if [[ $OPTARG == *"v"* ]]; then
                SKIP_VARIANTS=1
            fi
        fi
        ;;
      - )
        if [[ "$OPTARG" == "version" ]]; then
            echo "FluPore v${VERSION}"
            exit 1
        elif [[ "$OPTARG" == "help" ]]; then
            print_help_menu
        else
            echo -e "\nERROR: Invalid argument: --$OPTARG" 1>&2
            print_help_menu
        fi
        ;;
      h )
        print_help_menu
        ;;
      \? )
        echo -e "\nERROR: Invalid argument: -$OPTARG" 1>&2
        print_help_menu
        ;;
    esac
done


#Make a new demultiplexing folder if it doesn't exist
if [ ! -d "$DEM_DIR" ]; then
    mkdir "$DEM_DIR"
fi


#Auto-detect input type: pod5 (needs basecalling) or fastq (already basecalled)
NUM_POD5=$(find "$INP_DIR" -name "*.pod5" 2>/dev/null | wc -l)
NUM_FASTQ=$(find "$INP_DIR" \( -name "*.fastq" -o -name "*.fastq.gz" \) 2>/dev/null | wc -l)

if [ $SKIP_DORADO -eq 0 ] && [ "$NUM_POD5" -eq 0 ] && [ "$NUM_FASTQ" -eq 0 ]; then
    echo >&2 "ERROR: No pod5 or fastq/fastq.gz files found in $INP_DIR"
    exit 1
fi

#Basecalling + Demultiplexing
FAILED_DEM="ERROR: Dorado basecalling/demultiplexing failed!"
if [ $SKIP_DORADO -eq 0 ]; then
    if [ -z "$KIT_NAME" ]; then
        echo >&2 "ERROR: Please specify a barcode kit with -k (e.g., -k SQK-NBD114-96)"
        exit 1
    fi
    if [ "$NUM_POD5" -gt 0 ]; then
        # Detect whether a GPU is available; fall back to CPU if not
        if command -v nvidia-smi &>/dev/null && nvidia-smi &>/dev/null; then
            DORADO_DEVICE="cuda:all"
        else
            DORADO_DEVICE="cpu"
            echo -e "WARNING: No GPU detected — basecalling on CPU. This may take a very long time.\n"
        fi

        # Basecall to a single BAM file via stdout, then demux that file.
        # Using --output-dir creates a nested directory structure dorado demux
        # cannot search into; a single file path is unambiguous.
        BASECALL_BAM="${DEM_DIR}_basecalled_tmp.bam"

        echo -e "Step 1/2: Basecalling pod5 files with Dorado (device: ${DORADO_DEVICE}, model: ${BASECALL_MODEL})\n"
        dorado basecaller --device "$DORADO_DEVICE" "$BASECALL_MODEL" "$INP_DIR" \
            > "$BASECALL_BAM" 2>>"./${DEM_DIR}/dorado_err.log" || {
            echo >&2 "ERROR: Dorado basecalling failed!"
            exit 1
        }

        echo -e "Step 2/2: Demultiplexing basecalled reads with Dorado (kit: ${KIT_NAME})\n"
        dorado demux --kit-name "$KIT_NAME" --emit-fastq --threads "$NTHREADS" \
            --output-dir "$DEM_DIR" "$BASECALL_BAM" 2>>"./${DEM_DIR}/dorado_err.log" || {
            echo >&2 "ERROR: Dorado demultiplexing failed!"
            exit 1
        }

        # Clean up temp BAM file
        rm -f "$BASECALL_BAM"
    else
        echo -e "Detected FASTQ files — demultiplexing with Dorado (kit: ${KIT_NAME})\n"
        dorado demux --kit-name "$KIT_NAME" --emit-fastq --threads "$NTHREADS" \
            --output-dir "$DEM_DIR" "$INP_DIR" 2>>"./${DEM_DIR}/dorado_err.log" || {
            echo >&2 "$FAILED_DEM"
            exit 1
        }
    fi

    # Dorado v1.4+ nests output under no_sample/{run_id}/fastq_pass/barcodeXX/.
    # Flatten into barcode*/ directories directly under DEM_DIR.
    echo -e "Organizing Dorado output into barcode directories\n"
    find "$DEM_DIR" -mindepth 2 -name "*.fastq*" | while read -r f; do
        # Walk up the path to find the barcode directory name
        barcode_dir=""
        parent=$(dirname "$f")
        while [ "$parent" != "$DEM_DIR" ] && [ "$parent" != "/" ]; do
            dname=$(basename "$parent")
            if [[ "$dname" =~ ^barcode[0-9]+$ ]] || [[ "$dname" == "unclassified" ]]; then
                barcode_dir="$dname"
                break
            fi
            parent=$(dirname "$parent")
        done
        # Fall back to checking the filename itself
        if [ -z "$barcode_dir" ]; then
            fname=$(basename "$f")
            if [[ "$fname" =~ (barcode[0-9]+) ]]; then
                barcode_dir="${BASH_REMATCH[1]}"
            elif [[ "$fname" =~ unclassified ]]; then
                barcode_dir="unclassified"
            fi
        fi
        if [ -n "$barcode_dir" ]; then
            mkdir -p "${DEM_DIR}/${barcode_dir}"
            mv "$f" "${DEM_DIR}/${barcode_dir}/"
        fi
    done
    # Remove now-empty nested directories
    find "$DEM_DIR" -mindepth 1 -type d -empty -delete 2>/dev/null || true

    # Decompress any .fastq.gz files so downstream tools see plain *fastq
    find "$DEM_DIR" -name "*.fastq.gz" -exec gunzip {} \;
else
    echo -e "Skipping Dorado demultiplexing\n"
fi


#Resolve REF_FASTA to an absolute path before changing directories
if [ -n "$REF_FASTA" ]; then
    REF_FASTA=$(realpath "$REF_FASTA")

    #A reference written on Windows, or downloaded from GISAID, carries CRLF line
    #endings. samtools faidx and Biostrings both drop the CR, but minimap2 keeps
    #it as a sequence character. Positions after a CR then shift by one per CR,
    #so mpileup compares each read base against the wrong reference base and iVar
    #reports most of the segment as fixed variants. Normalise into the run
    #directory, which is where the reference is published anyway, so every tool
    #reads one identical file. Numbers in HANDOFF.md.
    if [ -n "$(tr -cd '\r' < "$REF_FASTA" | head -c1)" ]; then
        echo -e "NOTE: $(basename "$REF_FASTA") has CRLF line endings — using a normalised copy\n"
        tr -d '\r' < "$REF_FASTA" > "$DEM_DIR/.reference_normalised.fa"
        mv "$DEM_DIR/.reference_normalised.fa" "$DEM_DIR/reference.fa"
        REF_FASTA="$(cd "$DEM_DIR" && pwd)/reference.fa"
    fi

    #makeGTF.R assumes each segment is a coding sequence that starts at base 1. It
    #does not search for the start codon. Nothing downstream detects a broken
    #reference: makeGTF annotates the wrong frame, so every amino-acid call for the
    #segment is wrong. This check stops that. Each segment must pass two rules: base
    #1-3 is ATG, and the ORF from base 1 covers at least 50% of the segment. The 50%
    #floor is loose because MP and NS are bicistronic; their primary ORF (M1, NS1)
    #covers only 77-78%. Numbers in HANDOFF.md.
    ref_problems=$(awk '
        /^>/ { name=substr($0,2); sub(/[ \t].*/,"",name); order[++k]=name; next }
             { gsub(/[ \t\r]/,""); seq[name]=seq[name] toupper($0) }
        END {
            for (i=1; i<=k; i++) {
                nm=order[i]; s=seq[nm]; L=length(s)
                if (L < 6) {
                    printf "  %s: sequence is empty or too short (%d nt)\n", nm, L
                    continue
                }
                if (substr(s,1,3) != "ATG") {
                    printf "  %s: does not begin with a start codon (base 1-3 is %s, not ATG)\n", \
                           nm, substr(s,1,3)
                    continue
                }
                n = L - (L % 3); stop = 0
                for (p = 1; p + 2 <= n; p += 3) {
                    c = substr(s, p, 3)
                    if (c == "TAA" || c == "TAG" || c == "TGA") { stop = p; break }
                }
                orf = (stop > 0) ? stop - 1 : n
                if (100 * orf / L < 50)
                    printf "  %s: ORF from base 1 runs only %d aa before a stop (%.1f%% of %d nt) — the reading frame is wrong\n", \
                           nm, orf / 3, 100 * orf / L, L
            }
        }' "$REF_FASTA")

    if [ -n "$ref_problems" ]; then
        echo >&2 -e "\nERROR: $(basename "$REF_FASTA") is not a valid coding reference.\n"
        echo >&2 "$ref_problems"
        echo >&2 -e "\n       Each segment must be a coding sequence whose start codon is at base 1."
        echo >&2 -e "       Sequences taken from an alignment are the usual cause: they are trimmed"
        echo >&2 -e "       to an alignment column, not to a codon boundary, and gap-stripping can"
        echo >&2 -e "       shift the frame. Trim each segment to its own ATG before re-running.\n"
        exit 1
    fi
fi

cd "$DEM_DIR"

#Absolute path to the run (demux) directory, captured before the per-barcode
#loops change directories, so the variant_analysis step can be given an absolute
#target no matter what the working directory is by then.
DEM_ABS="$(pwd)"
FLUPORE_SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"


#Variant calling with minimap2 and iVar
FAILED_VAR="ERROR: Variant calling failed!"
if [ $SKIP_VARIANTS -eq 0 ] && [ -n "$REF_FASTA" ]; then
    echo -e "Calling variants with minimap2 and iVar\n"

    #Index the reference FASTA once before the per-barcode loop
    samtools faidx "$REF_FASTA" 2>>ivar_err.log || {
        echo >&2 "$FAILED_VAR"
        exit 1
    }

    for DIR in barcode*; do
        cd "$DIR" || {
            echo -e >&2 "\nERROR: There seem to be no barcode folders in your demultiplexing directory, $DEM_DIR"
            exit 1
        }

        echo "Calling variants for ${DIR}"

        #Gather reads, concatenating multiple FASTQs if present (mirrors IRMA logic)
        NUM_FASTQS=0
        NUM_FASTQS=$(ls *fastq 2>/dev/null | wc -l)
        if [ $NUM_FASTQS == 0 ]; then
            echo -e "WARNING: no fastq files in $DIR, skipping variant calling\n"
        else
            if [ $NUM_FASTQS == 1 ]; then
                VAR_FASTQ="$(ls *fastq)"
            else
                if [ -f variantSeqs.fastq ]; then
                    rm variantSeqs.fastq
                fi
                cat *fastq > variantSeqs.fastq
                VAR_FASTQ="variantSeqs.fastq"
            fi

            #Create per-barcode variants output directory
            mkdir -p variants

            #Map reads to user-provided reference with minimap2 and sort BAM
            minimap2 -ax map-ont -t "$NTHREADS" "$REF_FASTA" "$VAR_FASTQ" 2>>../ivar_err.log | \
                samtools sort -@ "$NTHREADS" -o "variants/${DIR}.sorted.bam" 2>>../ivar_err.log || {
                echo >&2 "$FAILED_VAR"
                exit 1
            }

            #Index BAM
            samtools index "variants/${DIR}.sorted.bam" 2>>../ivar_err.log || {
                echo >&2 "$FAILED_VAR"
                exit 1
            }

            #Generate pileup and call variants with iVar
            #  -aa: output all positions including zero-depth
            #  -A : include anomalous read pairs
            #  -d 0: no samtools depth cap (iVar -m handles depth filtering)
            #  -B : disable BAQ (recommended for iVar)
            #  -Q 0: no base quality filter at pileup stage (iVar -q handles it)
            samtools mpileup -aa -A -d 0 -B -Q 0 \
                -f "$REF_FASTA" "variants/${DIR}.sorted.bam" 2>>../ivar_err.log | \
                ivar variants \
                    -p "variants/${DIR}_variants" \
                    -q 20 \
                    -t "$MIN_FREQ" \
                    -m "$MIN_DEPTH" \
                    -r "$REF_FASTA" 2>>../ivar_err.log || {
                echo >&2 "$FAILED_VAR"
                exit 1
            }

            #Cleanup temporary concatenated reads file if created
            if [ -f variantSeqs.fastq ]; then
                rm variantSeqs.fastq
            fi
        fi

        cd ..

    done

elif [ $SKIP_VARIANTS -eq 0 ] && [ -z "$REF_FASTA" ]; then
    echo -e "WARNING: No reference FASTA provided (-r). Skipping variant calling.\n"
else
    echo -e "Skipping variant calling\n"
fi


#Concatenate all per-barcode iVar TSV files into one summary CSV with sample column
if [ $SKIP_VARIANTS -eq 0 ] && [ -n "$REF_FASTA" ]; then
    echo -e "Combining variant TSV files into sampleVariantsSummary.csv\n"
    VARIANT_SUMMARY="sampleVariantsSummary.csv"
    rm -f "$VARIANT_SUMMARY"
    HEADER_WRITTEN=0
    for DIR in barcode*; do
        TSV="${DIR}/variants/${DIR}_variants.tsv"
        if [ -f "$TSV" ]; then
            if [ $HEADER_WRITTEN -eq 0 ]; then
                # Write header with sample column prepended
                head -n 1 "$TSV" | awk 'BEGIN{OFS="\t"} {print "sample", $0}' >> "$VARIANT_SUMMARY"
                HEADER_WRITTEN=1
            fi
            # Write data rows with barcode name prepended
            tail -n +2 "$TSV" | awk -v sample="$DIR" 'BEGIN{OFS="\t"} {print sample, $0}' >> "$VARIANT_SUMMARY"
        fi
    done
    if [ $HEADER_WRITTEN -eq 0 ]; then
        echo -e "WARNING: No variant TSV files found — sampleVariantsSummary.csv not created.\n"
    fi
fi


#Assebmly with IRMA
FAILED_IRMA="ERROR: IRMA assembly failed!"
if [ $SKIP_IRMA -eq 0 ]; then
    echo -e "Assembling genomes using IRMA\n"
    for DIR in barcode*; do #move through barcode* folders
        cd "$DIR" || {
        echo -e >&2 "\nERROR: There seem to be no barcode folders in your demultiplexing directory, $DEM_DIR"
        exit 1
        }

        #remove the assembly folder if present
        if [ -e $IRMA_SAMP_NAME ]; then
            rm -r $IRMA_SAMP_NAME
        fi

        #count number of fastqs present and run IRMA accordingly
        echo "assembling ${DIR}"
        NUM_FASTQS=0
        NUM_FASTQS=$(ls *fastq | wc -l)
        if [ $NUM_FASTQS == 0 ]; then
            echo -e "WARNING: \nno fastq files in $DIR\n"
        else
            NUM_FASTQS=$(ls *fastq | wc -l)

            if [ $NUM_FASTQS == 1 ]; then
                FILE="$(ls *fastq)"
                IRMA FLU-minion "$FILE" "$IRMA_SAMP_NAME" 2>>../irma_err.log || {
                echo >&2 "$FAILED_IRMA"
                exit 1
                }
            else
                if [ -f allSeqs.fastq ]; then
                    rm allSeqs.fastq
                fi
                cat *fastq > allSeqs.fastq
                IRMA FLU-minion allSeqs.fastq "$IRMA_SAMP_NAME" 2>>../irma_err.log || {
                echo >&2 "$FAILED_IRMA"
	        exit 1
                }
                FILE="allSeqs.fastq"
            fi
        fi

        #remove the odd folder named the username and containing an empty 
        #  folder named IRMA with its version. Not sure why that one is 
        #  created by IRMA in the first place. Remove allSeqs.fastq as well
        for folder in *; do
            if [[ $folder != *".fastq" ]] && [[ $folder != "$IRMA_SAMP_NAME" ]] && [[ $folder != "variants" ]]; then
                rm -r $folder
                if [ -f allSeqs.fastq ]; then
                    rm allSeqs.fastq
                fi
            fi
        done

        cd ..

    done

else
    echo -e "Skipping IRMA assembly\n"
fi


#Combining IRMA's output into one fasta file per genome segment (modified from a script written by Megan Neveau) as well as one file per barcode
FAILED_COL="ERROR: file collection failed!"
if [ $SKIP_COMBINE -eq 0 ]; then
    #Remove combined fastas from previous runs of IRMA output combination
    outer_fasta_count="$(ls -l *.fasta 2>/dev/null | wc -l)"
    if (( $outer_fasta_count > 0 )); then
        rm *.fasta
    fi

    echo -e "\nCollecting IRMAs output\n"
    for dir in barcode*; do #move through barcode* folders again
        cd "$dir"
        full_dir=`pwd`
        barcode_number=`basename "$full_dir"`
        suffix="_${barcode_number}.fasta"
        cd "$IRMA_SAMP_NAME"
        fasta_count="$(ls -l *.fasta 2>/dev/null | wc -l)"
        
        ##Delete per barcode fasta if present (to deal with previous runs)
        perBarFasta="../../combined_${barcode_number}.fasta"
        if [ -f $perBarFasta ]; then
            rm "$perBarFasta"
        fi

        if [ $fasta_count != 0 ]; then
            for file in *.fasta; do
                seq_cat="../../$file"
                seq_ID="${file/.fasta/_${barcode_number}}"
                temp_file="${file/.fasta/_temp${suffix}}"
                awk -v name=$seq_ID '/^>/ {gsub(/.fa(sta)?$/,"",name);printf(">%s\n",name);next;} {print}' $file > $temp_file || {
                echo >&2 "$FAILED_COL"
                exit 1
                }
                #normalize sequence
                sed -e '/^[^>]/s/[^ATGCURYSWKMatgcuryswkm]/N/g' "$temp_file" >> "$seq_cat"
                sed -e '/^[^>]/s/[^ATGCURYSWKMatgcuryswkm]/N/g' "$temp_file" >> "$perBarFasta"
                rm "$temp_file"
            done
        fi
        cd ../..
    done
else
    echo -e "Skipping IRMA output collection\n"
fi


#Assemble the aggregated variant_analysis output from the per-barcode iVar and
#IRMA results: reshape the run directory in place (relative symlinks, no copying),
#then run the R/Python chain that builds all_sample_amino_acids.txt and the irma/
#tables. Runs whenever variants were called; it degrades cleanly if IRMA was
#skipped. A failure here is a warning, not fatal — the run's primary output is
#already done.
if [ $SKIP_VARIANTS -eq 0 ] && [ -n "$REF_FASTA" ]; then
    echo -e "Building variant_analysis output\n"
    RUN="$DEM_ABS"

    #skeleton
    mkdir -p "$RUN/variant_analysis/irma" \
             "$RUN/vcf_files" "$RUN/IRMA_results" \
             "$RUN/BAM_files" "$RUN/contigs" "$RUN/pipeline_info"

    #reference.fa at the root: findAAChanges.R reads OUTPUT_DIRECTORY/reference.fa,
    #makeGTF.R reads REFERENCE_FILE. Both point at the same file. The guard covers
    #-r already pointing here, and CRLF normalisation above, which both make this
    #a self-copy.
    [ "$REF_FASTA" -ef "$RUN/reference.fa" ] || cp -f "$REF_FASTA" "$RUN/reference.fa"

    #config.cfg consumed by the R scripts; mirrored into pipeline_info/.
    cat > "$RUN/config.cfg" <<CFG
OUTPUT_DIRECTORY="$RUN"
REFERENCE_FILE="$RUN/reference.fa"
METADATA="NULL"
MIN_DEPTH=$MIN_DEPTH
MIN_FREQ=$MIN_FREQ
MIN_ALT=$MIN_ALT
THREADS=$NTHREADS
CFG
    cp -f "$RUN/config.cfg" "$RUN/pipeline_info/config.cfg"

    #per-barcode reshape (relative symlinks; no copying)
    n_samp=0; n_ivar=0; n_bam=0
    for bc_path in "$RUN"/barcode*; do
        [ -d "$bc_path" ] || continue
        bc="$(basename "$bc_path")"
        asm="$bc_path/assembly"
        var="$bc_path/variants"
        [ -d "$asm" ] || { echo "  $bc: no assembly/, skipping"; continue; }
        n_samp=$((n_samp+1))

        #contigs/<sample>.fasta : IRMA per-segment consensus (headers >A_<SEG>)
        if ls "$asm"/A_*.fasta >/dev/null 2>&1; then
            cat "$asm"/A_*.fasta > "$RUN/contigs/$bc.fasta"
        fi

        #IRMA_results/<sample>/tables -> the assembly's own tables (relative)
        if [ -d "$asm/tables" ]; then
            mkdir -p "$RUN/IRMA_results/$bc"
            ln -sfn "../../$bc/assembly/tables" "$RUN/IRMA_results/$bc/tables"
        fi

        #vcf_files/<sample>/ivar-called-variants.tsv -> the iVar TSV
        if [ -f "$var/${bc}_variants.tsv" ]; then
            mkdir -p "$RUN/vcf_files/$bc"
            ln -sfn "../../$bc/variants/${bc}_variants.tsv" \
                    "$RUN/vcf_files/$bc/ivar-called-variants.tsv"
            n_ivar=$((n_ivar+1))
        fi

        #BAM_files/<sample>/final_mapped_reads.{bam,bai} -> the iVar sorted BAM
        #(index rename: the caller writes .sorted.bam.bai, the layout wants .bai).
        if [ -f "$var/${bc}.sorted.bam" ]; then
            mkdir -p "$RUN/BAM_files/$bc"
            ln -sfn "../../$bc/variants/${bc}.sorted.bam" \
                    "$RUN/BAM_files/$bc/final_mapped_reads.bam"
            [ -f "$var/${bc}.sorted.bam.bai" ] && \
                ln -sfn "../../$bc/variants/${bc}.sorted.bam.bai" \
                        "$RUN/BAM_files/$bc/final_mapped_reads.bai"
            n_bam=$((n_bam+1))
        fi
    done
    echo "  reshaped $n_samp sample(s): $n_ivar iVar table(s), $n_bam BAM(s)"

    #aggregation chain (shared with Flumina, kept in sync); chained so the first
    #failure short-circuits, and the spine test is the final gate.
    cfg="$RUN/config.cfg"
    Rscript "$FLUPORE_SCRIPTS/makeGTF.R" "$cfg" && \
    Rscript "$FLUPORE_SCRIPTS/convertVCFtoTable.R" "$cfg" && \
    Rscript "$FLUPORE_SCRIPTS/findAAChanges.R" "$cfg" && \
    python3 "$FLUPORE_SCRIPTS/irma_position_map.py" \
        --reference "$RUN/reference.fa" \
        --gtf       "$RUN/reference_gtf" \
        --contigs   "$RUN/contigs" \
        --irma      "$RUN/IRMA_results" \
        --min-depth "$MIN_DEPTH" \
        --out     "$RUN/variant_analysis/irma/irma_position_map.tsv" \
        --out-aa  "$RUN/variant_analysis/irma/irma_consensus_aa.tsv" \
        --out-var "$RUN/variant_analysis/irma/irma_variants.tsv" && \
    [ -f "$RUN/variant_analysis/all_sample_amino_acids.txt" ] || \
        echo -e >&2 "WARNING: variant_analysis step failed; run output is otherwise complete.\n"
fi

#Calculate and output QC values
barcodes=()
test=""
declare -A readCnts
declare -A readCnts2
if [ $SKIP_COMBINE -eq 0  ]; then 
    echo -e "Calculating QC values\n"

    ##Determine which segments are present and store them in a basic array
    segs=()
    for dir in barcode*; do
        cd $dir
        if [ -d "${IRMA_SAMP_NAME}/tables" ] && compgen -G "${IRMA_SAMP_NAME}/tables/*coverage.txt" > /dev/null; then
            cd $IRMA_SAMP_NAME
            for file in *fasta; do
                seg="${file/.fasta/}"
                if [[ ! "${segs[*]}" =~ "${seg}" ]]; then #add segment to list if it isn't already present
                    segs+=( "$seg" )
                fi
            done
            cd ..
        fi
        cd ..
    done

    ##Write title line for coverage file
    titleCov="sample,"
    for seg in ${segs[@]}; do
        titleCov+="${seg}_mean,"
        titleCov+="${seg}_min,"
        titleCov+="${seg}_Q1,"
        titleCov+="${seg}_median,"
        titleCov+="${seg}_Q3,"
        titleCov+="${seg}_max,"
    done

    titleCov=${titleCov::-1}   #remove extra comma
    echo $titleCov > coverageMeans.csv


    ##Go through barcode files, extract coverage information, calculate 
    ##   averages, medians, min, max, Q1, and Q3 values  and output to CSV
    ##    files. Also assemble total read counts into a seperate CSV.
    for dir in barcode*; do
        ###Build up a list of barcode names
        barcodes+=( $dir )
   
        cd $dir
        full_dir=`pwd`
        barcode_number=`basename "$full_dir"`

        ###reset variables for barcodes without all segments
        #total=""; mean=0; seg=""; min=0; q1=0; med=0; q3=0; max=0
        ####If coverage files don't exist for this barcode do nothing
        if [ -d "${IRMA_SAMP_NAME}/tables" ] && compgen -G "${IRMA_SAMP_NAME}/tables/*coverage.txt" > /dev/null; then
            cd "${IRMA_SAMP_NAME}/tables"
            ####for each coverage file add to an asociative array of key: segment  
            ####  val: c(min,q1,med,q3,max)
            unset segCov                                                             #reset the associative array
            declare -A segCov

	    ####  Otherwise use coverage files to calculate all statistics
            for file in *-coverage.txt
            do
                #####Mean calculcation
                mean=$(tail -n +2 $file | awk '{sum += $3} END {print sum / NR}')    #The mean of coverage values
                seg="${file/-coverage.txt/}"

                #####remove header and sort data for other calculations
                file2="coverageData_tmp.txt"
                fileFirst="coverageData_tmp_first.txt"
                fileLast="coverageData_tmp_last.txt"
                (tail -n +2  $file | cut -f 3 | sort -n > $file2)   
 
                #####calculate min and max
                min=$(head -n 1 $file2)
                max=$(tail -n 1 $file2)

                #####calculate quartiles including median
                numVals=$(wc -l $file2 | cut -d ' ' -f 1)
                med=-9 #instantiate med, this is used to pass numbers to and from functions
                if [ $((numVals%2)) -eq 0 ]; then
                    ######even number of data points
                    ######median
                    EvenMedian $numVals $file2
                    q2=$med
   
                    ######Q1 (the median of the first half of the data)
                    cutPoint=$(( (numVals + 1) / 2 ))
                    (head -n $cutPoint $file2 > $fileFirst)
                    numValsFirst=$(wc -l $fileFirst | cut -d ' ' -f 1)

                    if [ $((numValsFirst%2)) -eq 0  ]; then
                        EvenMedian $numValsFirst $fileFirst
                    else
                        OddMedian $numValsFirst $fileFirst
                    fi
                    q1=$med

                    ######Q3 (the median of the second half of the data)
                    cutPoint=$(( (numVals + 1) / 2))
                    (tail -n $cutPoint $file2 > $fileLast)
                    numValsLast=$(wc -l $fileLast | cut -d ' ' -f 1)

                    if [ $((numValsLast%2)) -eq 0  ]; then
                        EvenMedian $numValsLast $fileLast
                    else
                        OddMedian $numValsLast $fileLast
                    fi
                    q3=$med

                else
                    ######odd number of data points
                    ######median
                    OddMedian $numVals $file2
                    q2=$med

                    #Q1 (the median of the first half of the data)
                    midpoint=$(( (numVals + 1) / 2 ))
                    cutPoint=$(( midpoint - 1 ))
                    (head -n $cutPoint $file2 > $fileFirst)
                    numValsFirst=$(wc -l $fileFirst | cut -d ' ' -f 1)

                    if [ $((numValsFirst%2)) -eq 0  ]; then
                        EvenMedian $numValsFirst $fileFirst
                    else
                        OddMedian $numValsFirst $fileFirst
                    fi
                    q1=$med

                    #Q3 (the median of the second half of the data)
                    (tail -n $cutPoint $file2 > $fileLast)
                    numValsLast=$(wc -l $fileLast | cut -d ' ' -f 1)

                    if [ $((numValsLast%2)) -eq 0  ]; then
                        EvenMedian $numValsLast $fileLast
                    else
                        OddMedian $numValsLast $fileLast
                    fi
                    q3=$med
                fi

                stats=($mean $min $q1 $q2 $q3 $max)
                segCov["${seg}"]="${stats[@]}"

                ####Delete temporary files
    	        rm "$file2"
        	rm "$fileFirst"
        	rm "$fileLast"
            done

            ####Iterate through all segments (whether or not present in this 
            ####   barcode), get the coverage stats, and output the data to 
            ####   the csv file. This will be rearranged by statistic later
            newline="${barcode_number},"

            for seg in ${segs[@]}; do
                if [[ -n "${segCov["$seg"]}" ]]; then
                    statCov=${segCov["$seg"]}
                    #This while loop is to handle the fact that sometimes statCov comes in as an array and sometimes as a string. This ensures that each item within what should be an array is processed seperately in the for loop regardless
                    while IFS=" " read -ra ADDR; do 
                        for stat in "${ADDR[@]}"; do 
                            newline+="${stat},"
                        done
                    done <<< "${statCov[@]}"

                else
                    newline+=",,,,,," 
                fi
            done
            newline=${newline::-1}   #remove extra comma at the end of the line
            echo "$newline"          

           
            ####Grab the READ_COUNTS file, extract read count data, and store it
            ####   in a dict of key: ( barcodeName SegmentName ), val: readCount
            while read line; do
                if [ "${line:0:1}" == "4" ]; then
                    IFS="	" 
                    read -r -a lineLst <<< $line 
                    seg="${lineLst[0]:2:${#lineLst[0]}}"
                    readCnt=${lineLst[1]}
                    readCnts["${dir},${seg}"]=$readCnt 
                fi
            done < READ_COUNTS.txt


            ####Go through readCnts, calculate "all" values for each barcode as
            ####   well as for all barcodes and store them in a new dict along
            ####   with all items from the old dict
            for key in ${!readCnts[@]}; do
                #####add info from original dict
                readCnts2[$key]=${readCnts[$key]}
                
                #####calculate "all" values and store them in the new dict
                IFS=',' read -r -a keyLst <<< "$key"
                barAll="${keyLst[0]},all"
                total="all,all"

                if [[ $barAll =~ ${readCnts2} ]]; then
                    (( readCnts2[$barAll] += ${readCnts[$key]} ))
                else
                    readCnts2[$barAll]=${readCnts[$key]}
                fi 

                if [[ $total =~ ${readCnts2} ]]; then
                    (( readCnts2[$total] += ${readCnts[$key]} ))
                else
                    readCnts2[$total]=${readCnts[$key]}
                fi
            done
            
            cd ../..
        fi
        cd ..
    done >> coverageMeans.csv

    ##Remove readcounts files if necessary
    if [ -f readCountsDetailed.csv ]; then
        rm readCountsDetailed.csv
    fi
    if [ -f readCountsSummary.csv ]; then
        rm readCountsSummary.csv
    fi


    ##Go through readCnts2 and put data into temporary output files
    for key in ${!readCnts2[@]}; do    
        ###extract data from readCnts2
        IFS="," read -r -a keyLst <<< $key
        barcode=${keyLst[0]}
        segment=${keyLst[1]}
        readCnt=${readCnts2[$key]}

        ###write to the temporary output files
        if [[ "$barcode" == "all" || "$segment" == "all" ]]; then
            echo "${barcode},${segment},${readCnt}" >> tmp_readCountsSummary.csv
        else
            echo "${barcode},${segment},${readCnt}" >> tmp_readCountsDetailed.csv
        fi
    done


    ##Sort the temporary readCounts files
    sort tmp_readCountsSummary.csv > tmp2_readCountsSummary.csv
    sort tmp_readCountsDetailed.csv > tmp2_readCountsDetailed.csv


    ##Make titles for readCounts files,append them to the beginning of the readCounts files, and delete temporary files
    echo "barcode,segment,readCnt" | cat - tmp2_readCountsDetailed.csv > readCountsDetailed.csv
    echo "barcode,segment,readCnt" | cat - tmp2_readCountsSummary.csv > readCountsSummary.csv
    rm tmp_readCountsSummary.csv 
    rm tmp2_readCountsSummary.csv
    rm tmp_readCountsDetailed.csv 
    rm tmp2_readCountsDetailed.csv


    ##Rearrange the columns in the coverage file to sort by statistic rather than segment
    ###build awk string based on the number of barcodes
    awkString="BEGIN {FS=\",\"} ; {print \$1 \",\" "
    numStats=6
    numSegs="${#segs[@]}"
    allStats=$(( numStats * numSegs ))
    mostStats=$(( allStats - numStats + 1 ))
    ind=2
    for ((i=1; i<=$numStats; i++ )); do
        ind=$(( i + 1 ))
        awkString+="$"
        awkString+="$ind \",\" "
        while [ $ind -le $mostStats ]; do
            ind=$(( ind + numStats ))
            awkString+="$"
            awkString+="$ind \",\" "
        done
    done
    awkString=${awkString::-5}   #remove extra space request
    awkString+="}"

    echo "$awkString" > awkScript.awk
    awk -f awkScript.awk coverageMeans.csv > coverageStats.csv
    
    ###delete temporary files
    rm coverageMeans.csv
    rm awkScript.awk

else
    echo -e "Skipping QC value calculation \n"
fi


#Creating alignments from assembled sequences
swCombForClassH1="";swCombForClassH3=""; NON_IAV_FOUND=false
FAILED_MAFFT="ERROR: MAFFT alignment failed\n"
if [ $SKIP_MAFFT -eq 0 ]; then
    echo -e "Aligning assembled sequences using MAFFT\n"
    
    #For each fasta
    for file in *fasta; do
        if [[ ! "$file" == combined_barcode* ]]; then
            #For each segment+subtype, gather data from status file
            seg=$(echo $file | cut -d '.' -f 1)

            ##If IAV capture segment, reference files, and align user data 
            ##  with references, otherwise put the data in a seperate folder
            if [[ $seg == A_* ]]; then
                if [ $seg == "A_PB2" ]; then
                    while read line;do
