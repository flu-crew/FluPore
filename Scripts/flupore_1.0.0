                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/4_HA/H_H17/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/4_HA/H_H17/"
                elif [ $seg == "A_HA_H18" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/4_HA/I_H18/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/4_HA/I_H18/"
                elif [ $seg == "A_NP" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/5_NP/status.txt"
 
                    REF_DIR="${FLUPORE_DIR}/REFS/5_NP/"
                elif [ $seg == "A_NA_N1" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/6_NA/1_N1/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/6_NA/1_N1/"
                elif [ $seg == "A_NA_N2" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/6_NA/2_N2/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/6_NA/2_N2/"
                elif [ $seg == "A_NA_N3" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/6_NA/3_N3/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/6_NA/3_N3/"
                elif [ $seg == "A_NA_N4" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/6_NA/4_N4/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/6_NA/4_N4/"
                elif [ $seg == "A_NA_N5" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/6_NA/5_N5/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/6_NA/5_N5/"
                elif [ $seg == "A_NA_N6" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/6_NA/6_N6/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/6_NA/6_N6/"
                elif [ $seg == "A_NA_N7" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/6_NA/7_N7/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/6_NA/7_N7/"
                elif [ $seg == "A_NA_N8" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/6_NA/8_N8/status.txt"
  
                    REF_DIR="${FLUPORE_DIR}/REFS/6_NA/8_N8/"
                elif [ $seg == "A_NA_N9" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/6_NA/9_N9/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/6_NA/9_N9/"
                elif [ $seg == "A_NA_N10" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/6_NA/A_N10/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/6_NA/A_N10/"
                elif [ $seg == "A_NA_N11" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/6_NA/B_N11/status.txt"
   
                    REF_DIR="${FLUPORE_DIR}/REFS/6_NA/B_N11/"
                elif [ $seg == "A_MP" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/7_MP/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/7_MP/"
                elif [ $seg == "A_NS" ]; then
                    while read line;do
                        name=$(echo $line | cut -d ' ' -f 1)
                        if [ $name == "200" ]; then
                            twoHun=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "50" ]; then
                            fifty=$(echo $line | cut -d ' ' -f 2)
                        elif [ $name == "small" ]; then
                            small=$(echo $line | cut -d ' ' -f 2)
                        fi
                    done < "${FLUPORE_DIR}/REFS/8_NS/status.txt"

                    REF_DIR="${FLUPORE_DIR}/REFS/8_NS/"
                else
                     echo >&2 "ERROR: FluPore does not seem to have a reference to align with your data"
                     echo >&2 "${seg} is the segment"
                     exit 1
                fi


                #Align combined segment+subtype sequences with references 
                ##align 200 trees
                if [[ ! "$twoHun" =~ NA ]]; then #refs >=200
                    cat "$file" "${REF_DIR}${twoHun}" > "tmp_${seg}_twoHunComb.fasta"
                    twoHunCombFile="tmp_${seg}_twoHunComb.fasta"

                    mafft --quiet --thread "$NTHREADS" "$twoHunCombFile" 2>>mafft_err.log > "${twoHunCombFile/.fasta/.aln}" || {
                    echo -e >&2 "$FAILED_MAFFT"
	    	    echo -e >&2"1"
                    exit 1
                    }

                    if [[ $seg == "A_HA_H1" || $seg == "A_HA_H3" ]]; then
                        cat "$file" "${REF_DIR}${swTwoHun}" > "tmp_${seg}_swine_twoHunComb.fasta"
                        swTwoHunCombFile="tmp_${seg}_swine_twoHunComb.fasta"

                        mafft --quiet --thread "$NTHREADS" "$swTwoHunCombFile" 2>>mafft_err.log > "${swTwoHunCombFile/.fasta/.aln}" || {
                        echo -e >&2 "$FAILED_MAFFT"
                        echo -e >&2 "2"
                        exit 1
                        }

                        #capture the combined 200 file for classlog to use downstream
                        if [[ $seg == "A_HA_H1" ]]; then
	                    swCombForClassH1="$swTwoHunCombFile"
                        elif [[ $seg == "A_HA_H3" ]]; then
			    swCombForClassH3="$swTwoHunCombFile"
                        fi
                    fi

                else
                    if [[ ! "$fifty" =~ NA ]]; then
                        if [[ ! "$small" =~ NA ]]; then #50 < refs < 200
                            treeName_tmp=${twoHunCombFile/.fasta/.tre}
                            treeName=${treeName_tmp:4}
                            echo -e "Although less than 200 references were available for ${seg}, more than 50 were available and were used to generate ${treeName} and ${treeName}\n"
                            cat "$file" "${REF_DIR}${small}" > "tmp_${seg}_twoHunComb.fasta"
                            twoHunCombFile="tmp_${seg}_twoHunComb.fasta"

                            mafft --quiet --thread "$NTHREADS" "$twoHunCombFile" 2>>mafft_err.log > "${twoHunCombFile/.fasta/.aln}" || {
                            echo -e >&2 "$FAILED_MAFFT"
			    echo -e >&2 "3"
                            exit 1
                            }

                            if [[ $seg == "A_HA_H1" || $seg == "A_HA_H3" ]]; then
                                cat "$file" "${REF_DIR}${swTwoHun}" > "tmp_${seg}_swine_twoHunComb.fasta"
                                swTwoHunCombFile="tmp_${seg}_swine_twoHunComb.fasta"

                                mafft --quiet --thread "$NTHREADS" "$swTwoHunCombFile" 2>>mafft_err.log > "${swTwoHunCombFile/.fasta/.aln}" || {
                                echo -e >&2 "$FAILED_MAFFT"
	    	                echo -e >&2 "4"
                                exit 1
                                }

                                #capture the combined 200 file for classlog to use downstream
                                if [[ $seg == "A_HA_H1" ]]; then
                                    swCombForClassH1="${swTwoHunCombFile/.fasta/.aln}"
                                elif [[ $seg == "A_HA_H3" ]]; then
				    swCombForClassH3="${swTwoHunCombFile/.fasta/.aln}"
                                fi 
                            fi

                        fi
                    else #refs < 50
                        fiftyCombFile="tmp_${seg}_fiftyComb.fasta"
                        treeName_tmp=${fiftyCombFile/.fasta/.tre}
                        treeName=${treeName_tmp:4}
                        echo -e "Although less than 50 references were available for ${seg}, what was available was used to generate ${treeName} and ${treeName}\n"
                        fifty=$small
                    fi
                fi

                ##align 50 trees
                cat "$file" "${REF_DIR}${fifty}" > "tmp_${seg}_fiftyComb.fasta"
                fiftyCombFile="tmp_${seg}_fiftyComb.fasta"

                mafft --quiet --thread "$NTHREADS" "$fiftyCombFile" 2>>mafft_err.log > "${fiftyCombFile/.fasta/.aln}" || {
                echo -e >&2 "$FAILED_MAFFT"
                echo -e >&2 "5"
                exit 1
                } 

                if [[ $seg == "A_HA_H1" || $seg == "A_HA_H3" ]]; then
                    cat "$file" "${REF_DIR}${swFifty}" > "tmp_${seg}_swine_fiftyComb.fasta"
                    swFiftyCombFile="tmp_${seg}_swine_fiftyComb.fasta"
 
                    mafft --quiet --thread "$NTHREADS" "$swFiftyCombFile" 2>>mafft_err.log > "${swFiftyCombFile/.fasta/.aln}" || {
                    echo -e >&2 "$FAILED_MAFFT"
                    echo -e >&2 "6"
                    exit 1
                    }
                fi

            ##If not IAV, make a folder and put the sequences in it for no 
            ##  further analysis. Skip making the folder if it already exists
            else
                NON_IAV_FOUND=true
                if [ ! -d "NonIAVSeqs" ]; then
                    mkdir NonIAVSeqs
                fi
                mv "$file" NonIAVSeqs
            fi
        fi
    done
else
    echo -e "Skipping MAFFT alignment\n"
fi

#If non-IAV sequences were found inform the user
if [[ NON_IAV_FOUND == true ]]; then
    echo "Assembled sequences other than Influenza A detected. Storing these sequences in the folder 'NonIAVSeqs' within the output folder"
fi



#Generating a phylogenetic tree from assembled sequences and references
FAILED_FT="ERROR: FastTree maximum likelihood tree construction failed\n"
if [ $SKIP_MAFFT -eq 0 ]; then
    echo -e "Building maximum likelihood trees using FastTree\n"
    for file in tmp_*aln; do
        notmp="${file:4}"

        FastTree -quiet -nt "$file" 2>>fastt_err.log > "${notmp/.aln/.tre}" || {
        echo >&2 "$FAILED_FT"
        exit 1
        }
    done

    #cleanup by removing temporary files
    for file in tmp_*; do
        rm $file
    done

else
    echo -e "Skipping FastTree maximum likelihood tree construction\n"
fi


#Performing clade prediction
FAILED_HP="ERROR: Clade prediction failed\n"
if [ $SKIP_CLADEPRED -eq 0 ]; then
    ##Collect reference data from files
    REF_DIR_H1="${FLUPORE_DIR}/REFS/4_HA/1_H1/"
    REF_DIR_H3="${FLUPORE_DIR}/REFS/4_HA/3_H3/"

    while read line;do
        name=$(echo $line | cut -d ' ' -f 1)
        if [ $name == "pickle" ]; then
            swH1Train=$(echo $line | cut -d ' ' -f 2)
        fi
    done < "${REF_DIR_H1}/status.txt"

    while read line;do
        name=$(echo $line | cut -d ' ' -f 1)
        if [ $name == "pickle" ]; then
            swH3Train=$(echo $line | cut -d ' ' -f 2)
        fi          
    done < "${REF_DIR_H3}/status.txt"

    echo -e "Predicting clade using classLog\n"
    if [ -f A_HA_H1.fasta ]; then
        classlog predict "${REF_DIR_H1}${swH1Train}" A_HA_H1.fasta 2>>classlog_err.log > swineCladePrediction_H1.csv
        sed -i 's/\t/,/g' swineCladePrediction_H1.csv  #convert from tab delimited to CSV
    else
        echo -e "Clade prediction could not be completed for H1 due to a lack of H1 data in your data set\n"
    fi

    if [ -f A_HA_H3.fasta ]; then
        classlog predict "${REF_DIR_H3}${swH3Train}" A_HA_H3.fasta 2>>classlog_err.log > swineCladePrediction_H3.csv
	sed -i 's/\t/,/g' swineCladePrediction_H3.csv  #convert from tab delimited to CSV
    else
        echo -e "Clade prediction could not be completed for H3 due to a lack of H3 data in your data set\n"
    fi

else
    echo -e "Skipping clade prediction\n" 
fi


#Put error logs in their own folder
mkdir ErrorLogs
mv *_err.log ErrorLogs


echo -e "FluPore is finished!\n"




